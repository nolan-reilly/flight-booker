<h1>Flights#index</h1>

<%= form_with url: flights_path, method: :get do |form| %>
    <div>
        <%= form.label :arrival_airport %>
        <%= form.select :arrival_airport, Airport.order(:code).map { |airport| [airport.code, airport.id] } %>
    </div>

    <div>
        <%= form.label :departure_airport %>
        <%= form.select :departure_airport, Airport.order(:code).map { |airport| [airport.code, airport.id] } %>
    </div>

    <div>
        <%= form.label :num_passengers, "Number of Passengers" %>
        <%= form.number_field :num_passengers, min: 1, max: 4, required: true, value: 1 %>
    </div>

    <div>
        <%= form.label :start_date %>
        <%= form.date_field :start_date %>
    </div>

    <%= form.submit "Search" %>
<% end %>


<br>
<br>

<!-- Need to render each of the flights as its own form -->

<% if @flights.present? %>
    <%= form_with url: new_booking_path, method: :get do |form| %>
        <%= form.hidden_field :num_passengers, value: @num_passengers %>

        <% @flights.each do |flight| %>
            <%= form.radio_button :flight, flight.id  %>

            <p>Arrival Airport: <%= flight.arrival_airport.code %></p>
            <p>Departure Airport: <%= flight.departure_airport.code %></p>
            <p>Date: <%= flight.start_date %></p>
        <% end %>
    
        <%= form.submit "Book Flight" %>
    <% end %>
<% end %>
